# SM8475 platform switches shared by every board on this SoC.
# The device defconfig is applied after this file and may override any of them.
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
# No board on this SoC uses the composite NativeAES personalities yet.
CONFIG_XNU_NATIVE_AES=n
